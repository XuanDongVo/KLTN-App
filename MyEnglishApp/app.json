{
  "expo": {
    "name": "Fun English",
    "slug": "fun-english-kids",
    "scheme": "funenglish",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.funenglish.kids"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.funenglish.kids",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Fun English chọn ảnh cho nhiệm vụ học tập.",
          "cameraPermission": "Cho phép Fun English chụp ảnh cho nhiệm vụ học tập.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép Fun English dùng micro để con luyện phát âm tiếng Anh.",
          "recordAudioAndroid": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "164ac7ed-4507-4d2e-ae76-7c174f4dfbf2"
      }
    },
    "owner": "loanloan_04"
  }
}
